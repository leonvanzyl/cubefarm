{
  "name": "cubefarm",
  "version": "0.3.15",
  "description": "A cartoon 3D office where a team of AI coding agents works through your GitHub issues.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "claude-agent-sdk",
    "ai-agents",
    "coding-agents",
    "github-issues",
    "automation",
    "threejs"
  ],
  "homepage": "https://github.com/leonvanzyl/cubefarm#readme",
  "bugs": "https://github.com/leonvanzyl/cubefarm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonvanzyl/cubefarm.git"
  },
  "license": "MIT",
  "author": "Leon van Zyl",
  "type": "module",
  "bin": {
    "cubefarm": "bin/cubefarm.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/office.mjs --dev",
    "demo": "node scripts/office.mjs --dev --demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-server.mjs",
    "start": "node scripts/office.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/e2e-check.mjs",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "0.0.83",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "express": "^5.2.1",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@playwright/test": "1.56.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
